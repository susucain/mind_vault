NODE_ENV=development
PORT=3000

# 本地联调时可用；生产环境必须关闭
DEV_AUTH_ENABLED=true
APP_STANDALONE=false
HEALTH_CHECK_DEPENDENCIES=true
INGESTION_WORKER_ENABLED=false
STORAGE_ENABLED=false
STORAGE_MIRROR_SOURCE_BYTES=false
SOFFICE_BIN=soffice
JWT_SECRET=replace-with-a-long-random-secret

FAST_MODEL=qwen3.8-flash
FAST_MODEL_ENABLE_THINKING=false
REASONING_MODEL=deepseek-v4-flash-0731
REASONING_MODEL_ENABLE_THINKING=false
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1536

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_URI=mongodb://mongo_user:mongo_pass123@localhost:27017/knowledge_hub?authSource=admin
RABBITMQ_URL=amqp://guest:guest@localhost:5672
ELASTICSEARCH_NODE=http://localhost:9200
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=mind-vault
