IMAGE_TAG=sha-replace-me
ES_IMAGE_TAG=sha-replace-me

ACR_REGISTRY=crpi-replace-me.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=mind-vault
API_REPOSITORY=mind-vault-api
ES_REPOSITORY=mind-vault-elasticsearch

DATA_DIR=/opt/mind-vault/volumes
API_HOST_PORT=13000

POSTGRES_USER=mind_vault
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MONGO_ROOT_USER=mongo_root
MONGO_ROOT_PASSWORD=replace-with-random-password
MONGO_DATABASE=knowledge_hub
MONGO_HOST=mongodb
MONGO_PORT=27017

RABBITMQ_USER=mind_vault
RABBITMQ_PASSWORD=replace-with-random-password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

ELASTICSEARCH_HOST=es
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_NODE=http://es:9200

NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-random-password
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_URI=bolt://neo4j:7687

NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DEV_AUTH_ENABLED=false
HEALTH_CHECK_DEPENDENCIES=true
INGESTION_WORKER_ENABLED=false

STORAGE_ENABLED=true
OSS_ACCESS_KEY_ID=replace-with-ram-access-key
OSS_ACCESS_KEY_SECRET=replace-with-ram-secret
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET_NAME=replace-with-oss-bucket

FAST_MODEL=replace-me
REASONING_MODEL=replace-me
EMBEDDING_MODEL=replace-me
LLM_API_KEY=replace-me
LLM_BASE_URL=replace-me
EMBEDDING_API_KEY=replace-me
EMBEDDING_BASE_URL=replace-me
LANGFUSE_ENABLED=false
