.header {
  display: flex;
  flex-direction: column;
  padding: 28rpx 0 18rpx;
}
.kicker {
  color: #087f78;
  font-size: 24rpx;
  font-weight: 700;
}
.title {
  margin-top: 12rpx;
  color: #17232e;
  font-size: 48rpx;
  font-weight: 700;
}
.filters {
  display: flex;
  gap: 12rpx;
  margin: 12rpx 0 22rpx;
}
.filter {
  padding: 12rpx 20rpx;
  border: 1rpx solid #dfe7e5;
  border-radius: 8rpx;
  color: #718087;
  background: #fff;
  font-size: 24rpx;
}
.filter-active {
  border-color: #087f78;
  color: #087f78;
  background: #e7f5f1;
  font-weight: 700;
}
.session-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.session {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}
.kind {
  display: grid;
  width: 56rpx;
  height: 56rpx;
  place-items: center;
  border-radius: 12rpx;
  color: #087f78;
  background: #e2f4f1;
  font-size: 26rpx;
  font-weight: 700;
}
.kind.interview {
  color: #d9672c;
  background: #fff0e4;
}
.session-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}
.session-title {
  overflow: hidden;
  color: #17232e;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.session-copy {
  margin-top: 8rpx;
  color: #718087;
  font-size: 23rpx;
}
.arrow {
  color: #718087;
  font-size: 40rpx;
}
