<view class="page chat-page">
  <view class="chat-header">
    <view class="chat-heading">
      <text class="kicker">ASK YOUR SOURCES</text>
      <text class="title" bind:tap="toggleConversationPicker">{{currentConversationTitle}}</text>
    </view>
    <van-button type="primary" size="small" plain bind:click="newConversation">新对话</van-button>
  </view>
  <view wx:if="{{showConversationPicker}}" class="conversation-picker">
    <view wx:for="{{conversations}}" wx:key="id" class="conversation-option {{item.id === conversationId ? 'conversation-option-active' : ''}}" data-id="{{item.id}}" bind:tap="selectConversation">
      {{item.title}}
    </view>
  </view>
  <view wx:if="{{datasets.length}}" class="dataset-scope">
    <view class="dataset-scope-summary">
      <text class="dataset-scope-label">{{datasetScopeLabel}}</text>
      <van-button size="small" plain bind:click="openDatasetSelector">切换</van-button>
    </view>
  </view>
  <app-state wx:if="{{loading}}" type="loading"></app-state>
  <app-state wx:elif="{{error}}" type="error" title="问答初始化失败" description="{{error}}" bind:action="initialize"></app-state>
  <app-state wx:elif="{{datasets.length === 0}}" type="empty" title="还没有可问答的资料集" description="请先在知识库中创建资料集并上传文档。"></app-state>
  <scroll-view wx:else class="message-list" scroll-y scroll-into-view="{{scrollTo}}">
    <view wx:for="{{messages}}" wx:key="id" id="message-{{index}}" class="message {{item.role}}">
      <view class="bubble">
        <mp-html wx:if="{{item.rendered}}" class="message-content markdown-content" content="{{item.markdownContent}}" scroll-table="{{true}}" selectable="{{true}}"></mp-html>
        <text wx:else class="message-content">{{item.content || (item.streaming ? '正在生成回答...' : '')}}</text>
        <text wx:if="{{item.stage}}" class="message-stage">{{item.stage}}</text>
        <view wx:if="{{item.role === 'assistant' && (item.usedMemory || item.toolLabels.length || item.model || item.thinking || item.answerMode)}}" class="message-meta">
          <text wx:if="{{item.usedMemory}}" class="memory-hint">已参考你的记忆</text>
          <text wx:if="{{item.answerMode === 'rag'}}">已基于资料检索</text>
          <text wx:if="{{item.answerMode === 'general'}}">使用通用知识补答</text>
          <text wx:if="{{item.toolLabels.length}}">{{item.toolLabels.join(' · ')}}</text>
          <text wx:if="{{item.model}}">{{item.model}}</text>
          <text wx:if="{{item.thinking}}">thinking</text>
        </view>
        <citation-card wx:for="{{item.citations}}" wx:for-item="citation" wx:key="id" citation="{{citation}}"></citation-card>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{!loading && !error && datasets.length}}" class="composer surface">
    <van-field value="{{input}}" placeholder="问问你的资料" border="{{false}}" maxlength="4000" bind:change="updateInput" class="ask-input" type="textarea" autosize="{{ { maxHeight: 100 } }}"/>
    <van-button wx:if="{{sending}}" size="small" plain loading="{{stopping}}" bind:click="stopGeneration" custom-class="send-btn">
      <van-icon name="stop" custom-class="send-icon" size="{{25}}" style="height: 30px"/>
    </van-button>
    <van-button wx:else type="primary" size="small" bind:click="sendMessage" custom-class="send-btn">
      <van-icon name="down" custom-class="send-icon" />
    </van-button>
  </view>
  <van-popup
    show="{{showDatasetSelector}}"
    position="bottom"
    round
    bind:close="closeDatasetSelector"
  >
    <view class="dataset-selector-panel">
      <view class="dataset-selector-head">
        <text>选择资料范围</text>
        <text class="dataset-selector-cancel" bind:tap="closeDatasetSelector">取消</text>
      </view>
      <van-field
        value="{{datasetQuery}}"
        placeholder="搜索资料集"
        border="{{true}}"
        bind:change="updateDatasetQuery"
        custom-class="dataset-search-field"
        input-class="dataset-search-input"
      />
      <view
        class="dataset-scope-option {{isAllScope ? 'dataset-scope-option-active' : ''}}"
        bind:tap="toggleAllDatasets"
      >
        <text>全部资料</text>
        <text>{{isAllScope ? '已选' : '快捷全选'}}</text>
      </view>
      <text wx:if="{{searchingDatasets}}" class="dataset-feedback">正在搜索</text>
      <text wx:elif="{{!datasetResults.length}}" class="dataset-feedback">没有匹配的资料集</text>
      <view
        wx:for="{{datasetResults}}"
        wx:key="id"
        class="dataset-scope-option {{draftDatasetIds.includes(item.id) ? 'dataset-scope-option-active' : ''}}"
        data-id="{{item.id}}"
        bind:tap="toggleDraftDataset"
      >
        <text>{{item.name}}</text>
        <text>{{draftDatasetIds.includes(item.id) ? '已选' : '选择'}}</text>
      </view>
      <text wx:if="{{datasetScopeError}}" class="dataset-scope-error">{{datasetScopeError}}</text>
      <van-button
        type="primary"
        block
        loading="{{savingDatasetScope}}"
        disabled="{{savingDatasetScope}}"
        bind:click="saveDatasetScope"
      >
        完成
      </van-button>
    </view>
  </van-popup>
</view>
