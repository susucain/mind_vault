<view class="page chat-page">
  <view class="chat-header">
    <view class="chat-heading">
      <text class="kicker">ASK YOUR SOURCES</text>
      <text class="title">资料问答</text>
    </view>
    <van-button type="primary" size="small" plain bind:click="newConversation">新对话</van-button>
  </view>

  <scroll-view class="dataset-scroll" scroll-x>
    <view
      wx:for="{{datasets}}"
      wx:key="id"
      class="dataset-chip {{selectedDatasetIds.includes(item.id) ? 'dataset-chip-active' : ''}}"
      data-id="{{item.id}}"
      bind:tap="toggleDataset"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <app-state wx:if="{{loading}}" type="loading"></app-state>
  <app-state
    wx:elif="{{error}}"
    type="error"
    title="问答初始化失败"
    description="{{error}}"
    bind:action="initialize"
  ></app-state>
  <app-state
    wx:elif="{{datasets.length === 0}}"
    type="empty"
    title="还没有可问答的资料集"
    description="请先在知识库中创建资料集并上传文档。"
  ></app-state>

  <scroll-view wx:else class="message-list" scroll-y scroll-into-view="{{scrollTo}}">
    <view wx:for="{{messages}}" wx:key="id" id="message-{{index}}" class="message {{item.role}}">
      <view class="bubble">
        <text class="message-content">{{item.content || (item.streaming ? '正在生成回答...' : '')}}</text>
        <view
          wx:if="{{item.role === 'assistant' && (item.usedMemory || item.usedTools.length || item.model || item.thinking)}}"
          class="message-meta"
        >
          <text wx:if="{{item.usedMemory}}" class="memory-hint">已参考你的记忆</text>
          <text wx:if="{{item.usedTools.length}}">{{item.usedTools.join(' · ')}}</text>
          <text wx:if="{{item.model}}">{{item.model}}</text>
          <text wx:if="{{item.thinking}}">thinking</text>
        </view>
        <citation-card
          wx:for="{{item.citations}}"
          wx:for-item="citation"
          wx:key="id"
          citation="{{citation}}"
        ></citation-card>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && !error && datasets.length}}" class="composer surface">
    <van-field
      value="{{input}}"
      placeholder="问问你的资料"
      border="{{false}}"
      maxlength="4000"
      bind:change="updateInput"
    />
    <van-button type="primary" size="small" loading="{{sending}}" bind:click="sendMessage">发送</van-button>
  </view>
</view>
