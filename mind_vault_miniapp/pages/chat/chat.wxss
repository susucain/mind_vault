.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 150rpx;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
}

.chat-heading {
  display: flex;
  flex-direction: column;
}

.conversation-picker {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 12rpx;
  padding: 12rpx;
  border: 1rpx solid #dfe7e5;
  background: #ffffff;
}

.conversation-option {
  overflow: hidden;
  padding: 16rpx;
  color: #52636b;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-option-active {
  color: #087f78;
  background: #e7f5f1;
  font-weight: 700;
}

.kicker {
  color: #087f78;
  font-size: 22rpx;
  font-weight: 700;
}

.title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.dataset-scope {
  margin: 22rpx 0 24rpx;
}

.dataset-scope-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.dataset-scope-current,
.dataset-scope-switch {
  display: flex;
  min-height: 65rpx;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 600;
}

.dataset-scope-current {
  flex: 1;
  min-width: 0;
  border: 2rpx solid #087f78;
  color: #087f78;
  background: #e7f5f1;
}

.dataset-scope-switch {
  flex: 0 0 auto;
  border: 2rpx solid #c8ddd8;
  color: #087f78;
  background: #ffffff;
}

.dataset-scope-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-list {
  flex: 1;
  min-height: 0;
  padding: 16rpx 0;
}

.message {
  display: flex;
  margin: 18rpx 0;
}

.message.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 88%;
  padding: 22rpx;
  border: 1rpx solid #e0e8e6;
  border-radius: 14rpx;
  background: #ffffff;
}

.user .bubble {
  border-color: #087f78;
  color: #ffffff;
  background: #087f78;
}

.message-content {
  font-size: 27rpx;
  line-height: 1.7;
  /* white-space: pre-wrap; */
}

.markdown-content {
  display: block;
  white-space: normal;
}

.message-stage {
  display: block;
  margin-top: 12rpx;
  color: #8a8178;
  font-size: 24rpx;
}

.message-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
  color: #718087;
  font-size: 20rpx;
}

.memory-hint {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  color: #087f78;
  background: #e7f5f1;
  font-weight: 700;
}

.composer {
  position: fixed;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx;
  box-shadow: 0 8rpx 28rpx rgba(27, 48, 53, 0.1);
}

.ask-input {
  flex: 1;
}

.send-btn {
  width: 100rpx !important;
  min-width: 100rpx !important;
  border-radius: 10rpx !important;
}

.send-icon {
  transform: rotate(180deg);
}

.dataset-selector-panel {
  padding: 28rpx 24rpx 36rpx;
}

.dataset-selector-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  color: #17232e;
  font-size: 30rpx;
  font-weight: 700;
}

.dataset-selector-cancel {
  color: #718087;
  font-size: 24rpx;
  font-weight: 400;
}

.dataset-search-field {
  /* padding: 8rpx 12rpx !important; */
}

.dataset-search-input {
  font-size: 25rpx !important;
}

.dataset-scope-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 10rpx;
  padding: 20rpx 16rpx;
  border-radius: 6rpx;
  color: #52636b;
  font-size: 25rpx;
}

.dataset-scope-option-active {
  color: #087f78;
  font-weight: 600;
}

.dataset-feedback-slot {
  display: flex;
  height: 46rpx;
  align-items: center;
  padding: 0 12rpx;
  color: #718087;
  font-size: 24rpx;
}

.dataset-scope-error {
  display: block;
  margin: 16rpx 0;
  color: #c65353;
  font-size: 23rpx;
  line-height: 1.5;
}
