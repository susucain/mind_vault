<view class="page">
  <view class="header">
    <text class="kicker">KNOWLEDGE LIBRARY</text>
    <text class="title">知识库</text>
    <text class="subtitle">在这里管理资料集、文档和解析进度。</text>
  </view>

  <view wx:if="{{datasets.length}}" class="dataset-area">
    <view class="dataset-control">
      <view class="dataset-current" bind:tap="toggleDatasetSelector">
        <text>{{selectedDatasetName || '选择资料集'}}</text>
        <text>⌄</text>
      </view>
    </view>
    <view wx:if="{{recentDatasets.length}}" class="recent-datasets">
      <view wx:for="{{recentDatasets}}" wx:key="id" class="recent-chip {{item.id === selectedDatasetId ? 'recent-chip-active' : ''}}" data-id="{{item.id}}" bind:tap="selectDatasetResult">{{item.name}}</view>
    </view>
    <view wx:if="{{showDatasetSelector}}" class="dataset-selector surface">
      <van-field value="{{datasetQuery}}" placeholder="搜索资料集" border="{{false}}" bind:change="updateDatasetQuery" />
      <text wx:if="{{searchingDatasets}}" class="dataset-feedback">正在搜索</text>
      <text wx:elif="{{!datasetResults.length}}" class="dataset-feedback">没有匹配的资料集</text>
      <view wx:for="{{datasetResults}}" wx:key="id" class="dataset-result {{item.id === selectedDatasetId ? 'dataset-result-active' : ''}}" data-id="{{item.id}}" bind:tap="selectDatasetResult">
        <text>{{item.name}}</text>
        <text wx:if="{{item.id === selectedDatasetId}}">当前</text>
      </view>
      <view class="dataset-create" bind:tap="openCreateDataset">+ 新建资料集</view>
    </view>
  </view>
  <view wx:if="{{selectedDatasetId}}" class="upload surface">
    <view class="dataset-overview">
      <view class="overview-item">
        <text class="overview-value">{{totalDocuments}}</text>
        <text class="overview-label">文档</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{availableDocuments}}</text>
        <text class="overview-label">可问答</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{processingDocuments}}</text>
        <text class="overview-label">处理中</text>
      </view>
    </view>
  </view>

  <view wx:if="{{selectedDatasetId}}" class="upload surface">
    <view class="upload-copy">
      <text class="upload-title">导入到【{{selectedDatasetName}}】</text>
      <text class="upload-desc">PDF、Office、TXT，最大 100MB</text>
    </view>
    <van-button type="primary" size="small" loading="{{uploading}}" bind:click="chooseAndUpload">
      选择文件
    </van-button>
  </view>

  <view wx:if="{{uploadFileName}}" class="upload-status surface">
    <view class="upload-status-row">
      <text class="upload-file">{{uploadFileName}}</text>
      <text class="upload-stage">{{uploadStatus || 'UPLOADED'}}</text>
    </view>
    <van-progress percentage="{{uploadProgress}}" color="#087f78" stroke-width="6" />
    <view wx:if="{{uploadStageProgress && uploadStatus !== 'READY'}}" class="upload-process">
      <text>{{uploadStageProgress.completed}}/{{uploadStageProgress.total}}</text>
      <text>{{uploadEta}}</text>
    </view>
    <van-progress
      wx:if="{{uploadStageProgress && uploadStatus !== 'READY'}}"
      percentage="{{uploadStageProgress.percent}}"
      color="#4d8fba"
      stroke-width="4"
    />
    <view wx:if="{{uploadGraph}}" class="upload-process">
      <text>{{uploadGraphLabel}} {{uploadGraph.completed}}/{{uploadGraph.total}}</text>
      <text>{{uploadGraph.estimatedRemainingSeconds === null ? '正在估算' : uploadEta}}</text>
    </view>
    <text wx:if="{{uploadError}}" class="upload-error">{{uploadError}}</text>
    <van-button
      wx:if="{{uploadStatus === 'FAILED'}}"
      type="primary"
      plain
      size="small"
      bind:click="retryUploadProcess"
    >
      重试解析
    </van-button>
  </view>

  <app-state wx:if="{{loading}}" type="loading"></app-state>
  <app-state
    wx:elif="{{error}}"
    type="error"
    title="知识库加载失败"
    description="{{error}}"
    bind:action="loadLibrary"
  ></app-state>
  <app-state
    wx:elif="{{datasets.length === 0}}"
    type="empty"
    title="还没有资料集"
    description="新建资料集后即可上传和管理文档。"
  ></app-state>
  <app-state
    wx:elif="{{documents.length === 0}}"
    type="empty"
    title="资料集内还没有文档"
    description="文件上传将在下一阶段接入。"
  ></app-state>

  <view wx:else class="document-list">
    <view class="document-list-head">
      <text>全部文档</text>
      <text>已显示 {{documents.length}} 篇</text>
    </view>
    <view
      wx:for="{{documents}}"
      wx:key="id"
      class="document surface"
      data-id="{{item.id}}"
      bind:tap="openDocument"
    >
      <view class="document-type">{{item.sourceFileExtension || 'FILE'}}</view>
      <view class="document-main">
        <text class="document-title">{{item.title}}</text>
        <text class="document-meta">{{item.sourceFileName || '未命名文件'}}</text>
        <view class="document-ingestion-row">
          <text
            class="document-ingestion {{item.ingestionStatus === 'FAILED' ? 'document-ingestion-failed' : ''}}"
          >
            {{item.ingestionStatusLabel}}
          </text>
          <text wx:if="{{item.graphStatusLabel}}" class="document-ingestion">
            {{item.graphStatusLabel}} {{item.graphProgressLabel}}
          </text>
          <van-button
            wx:if="{{item.canRetryIngestion}}"
            size="mini"
            plain
            type="primary"
            loading="{{retryingDocumentId === item.id}}"
            data-id="{{item.id}}"
            catchtap="stopDocumentOpen"
            bind:click="retryDocument"
          >
            重试解析
          </van-button>
        </view>
        <text wx:if="{{item.ingestionErrorMessage}}" class="document-error">
          {{item.ingestionErrorMessage}}
        </text>
      </view>
      <text class="document-arrow">›</text>
    </view>
    <view wx:if="{{loadingMoreDocuments}}" class="document-list-footer">正在加载更多文档</view>
    <view wx:elif="{{!hasMoreDocuments && documents.length}}" class="document-list-footer">已加载全部文档</view>
  </view>

  <van-popup show="{{showCreateDataset}}" position="bottom" round bind:close="closeCreateDataset">
    <view class="create-panel">
      <text class="create-title">新建资料集</text>
      <van-field value="{{datasetName}}" label="名称" placeholder="例如：后端面试" bind:change="updateDatasetName" />
      <van-field value="{{datasetDescription}}" label="说明" placeholder="可选" bind:change="updateDatasetDescription" />
      <van-button type="primary" block loading="{{creating}}" bind:click="createDataset">创建资料集</van-button>
    </view>
  </van-popup>
</view>
