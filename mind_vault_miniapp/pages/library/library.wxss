.header {
  display: flex;
  flex-direction: column;
  padding: 28rpx 0;
}

.kicker {
  color: #087f78;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 16rpx;
  color: #718087;
  font-size: 28rpx;
}

.dataset-area {
  position: relative;
  margin: 10rpx 0 12rpx;
}

.dataset-control {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.dataset-current {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border: 1rpx solid #c8ddd8;
  border-radius: 6rpx;
  color: #173a39;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.dataset-current text:first-child {
  overflow: hidden;
  min-width: 0;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-datasets {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  overflow: hidden;
  white-space: nowrap;
}

.recent-label {
  color: #087f78;
  font-size: 22rpx;
  font-weight: 700;
}

.recent-chip {
  overflow: hidden;
  max-width: 200rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  color: #087f78;
  background: #e7f5f1;
  font-size: 22rpx;
  text-overflow: ellipsis;
}

.recent-chip-active {
  background: #ccebe5;
  font-weight: 700;
}

.upload,
.upload-status {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 18rpx 0;
  padding: 24rpx;
}

.upload {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 20rpx;
}

.dataset-overview {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.overview-item {
  display: flex;
  min-height: 104rpx;
  flex-direction: column;
  justify-content: center;
  padding: 16rpx;
  border-radius: 6rpx;
  background: #edf5f3;
}

.overview-value {
  color: #087f78;
  font-size: 38rpx;
  font-weight: 700;
}

.overview-label {
  margin-top: 6rpx;
  color: #61727a;
  font-size: 20rpx;
}

.dataset-document-head {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #17232e;
  font-size: 32rpx;
  font-weight: 700;
}

.dataset-document-head text:last-child {
  color: #718087;
  font-size: 22rpx;
  font-weight: 400;
}

.upload-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.upload-title {
  font-size: 28rpx;
  font-weight: 700;
}

.upload-desc {
  margin-top: 8rpx;
  color: #718087;
  font-size: 22rpx;
  line-height: 1.5;
}

.upload-status {
  flex-direction: column;
  align-items: stretch;
}

.upload-status-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.upload-file {
  overflow: hidden;
  flex: 1;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-stage {
  color: #087f78;
  font-size: 22rpx;
  font-weight: 700;
}

.upload-error {
  color: #c65353;
  font-size: 22rpx;
  line-height: 1.5;
}

.dataset-selector {
  position: absolute;
  z-index: 4;
  top: 82rpx;
  right: 0;
  left: 0;
  overflow: hidden;
  padding: 12rpx;
}

.dataset-feedback,
.dataset-result {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 14rpx;
  color: #61727a;
  font-size: 24rpx;
}

.dataset-result-active {
  border-radius: 4rpx;
  color: #087f78;
  background: #e7f5f1;
  font-weight: 700;
}

.dataset-create {
  padding: 18rpx 14rpx;
  border-top: 1rpx solid #e2ebe8;
  color: #087f78;
  font-size: 24rpx;
  font-weight: 700;
}

.document-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.document-list-head {
  display: flex;
  justify-content: space-between;
  color: #61727a;
  font-size: 22rpx;
}

.document-list-head text:first-child {
  color: #17232e;
  font-size: 28rpx;
  font-weight: 700;
}

.document-list-footer {
  padding: 16rpx;
  color: #718087;
  font-size: 22rpx;
  text-align: center;
}

.document {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.document-type {
  min-width: 72rpx;
  padding: 12rpx 8rpx;
  border-radius: 10rpx;
  color: #087f78;
  background: #e7f5f1;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  text-transform: uppercase;
}

.document-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 20rpx;
}

.document-title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.document-meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: #718087;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.document-ingestion-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.document-ingestion {
  color: #087f78;
  font-size: 20rpx;
}

.document-ingestion-failed,
.document-error {
  color: #c65353;
}

.document-error {
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.document-arrow {
  color: #8b969a;
  font-size: 40rpx;
}

.create-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 36rpx 32rpx 52rpx;
}

.create-title {
  font-size: 32rpx;
  font-weight: 700;
}
