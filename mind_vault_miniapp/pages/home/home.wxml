<view class="page">
  <view class="welcome">
    <text class="kicker">MIND VAULT</text>
    <text class="title">你的资料，随时可问。</text>
    <text class="subtitle">上传、检索、引用和面试训练都将在这里完成。</text>
  </view>

  <view wx:if="{{!loading && !error}}" class="status surface">
    <text class="status-label">服务状态</text>
    <text class="status-ok">{{health === 'ok' ? '可用' : '部分不可用'}}</text>
  </view>

  <app-state wx:if="{{loading}}" type="loading"></app-state>
  <app-state
    wx:if="{{error}}"
    type="error"
    title="服务暂时不可用"
    description="{{error}}"
    bind:action="loadHealth"
  ></app-state>

  <view wx:if="{{!loading && !error}}" class="section-title">开始使用</view>
  <view wx:if="{{!loading && !error}}" class="actions">
    <view class="action-card surface" bind:tap="openLibrary">
      <text class="action-title">管理资料</text>
      <text class="action-copy">建立资料集并上传文件</text>
    </view>
    <view class="action-card surface" bind:tap="openInterview">
      <text class="action-title">面试训练</text>
      <text class="action-copy">基于项目资料进行追问</text>
    </view>
  </view>
</view>
