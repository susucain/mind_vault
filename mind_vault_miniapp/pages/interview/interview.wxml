<view class="page">
  <view class="header">
    <view class="header-top">
      <text class="kicker">INTERVIEW COACH</text>
      <view class="review-entry" bind:tap="openReviews">复习 ›</view>
    </view>
    <text class="title">面试训练</text>
    <text class="subtitle">从你的项目资料中生成问题、追问和复习项。</text>
  </view>

  <app-state wx:if="{{loading}}" type="loading"></app-state>
  <app-state
    wx:elif="{{error}}"
    type="error"
    title="训练资料加载失败"
    description="{{error}}"
    bind:action="loadDatasets"
  ></app-state>
  <app-state
    wx:elif="{{datasets.length === 0}}"
    type="empty"
    title="还没有可训练的资料集"
    description="请先在知识库上传项目或面试资料。"
  ></app-state>

  <view wx:elif="{{!session}}" class="training surface">
    <text class="training-title">开始训练</text>
    <text class="training-copy">选择资料集、主题和强度。</text>

    <scroll-view class="dataset-scroll" scroll-x>
      <view
        wx:for="{{datasets}}"
        wx:key="id"
        class="dataset-chip {{item.id === selectedDatasetId ? 'dataset-chip-active' : ''}}"
        data-id="{{item.id}}"
        bind:tap="selectDataset"
      >
        {{item.name}}
      </view>
    </scroll-view>

    <text class="field-label">主题</text>
    <view class="mode-grid">
      <view class="mode {{topic === 'project_deep_dive' ? 'mode-active' : ''}}" data-topic="project_deep_dive" bind:tap="selectTopic">项目深挖</view>
      <view class="mode {{topic === 'technical_fundamentals' ? 'mode-active' : ''}}" data-topic="technical_fundamentals" bind:tap="selectTopic">技术基础</view>
      <view class="mode {{topic === 'job_fit' ? 'mode-active' : ''}}" data-topic="job_fit" bind:tap="selectTopic">岗位匹配</view>
      <view class="mode {{topic === 'system_design' ? 'mode-active' : ''}}" data-topic="system_design" bind:tap="selectTopic">系统设计</view>
    </view>

    <text class="field-label">强度</text>
    <view class="mode-grid">
      <view class="mode {{intensity === 'quick' ? 'mode-active' : ''}}" data-intensity="quick" bind:tap="selectIntensity">快速</view>
      <view class="mode {{intensity === 'deep' ? 'mode-active' : ''}}" data-intensity="deep" bind:tap="selectIntensity">深度</view>
    </view>

    <van-field
      value="{{focus}}"
      maxlength="200"
      label="聚焦"
      placeholder="可选：想重点练的方向"
      border="{{false}}"
      bind:change="updateFocus"
    />

    <view class="jd-trigger" bind:tap="openJobDescription">
      <text>岗位描述</text>
      <text class="jd-trigger-value">{{jobDescription ? '已填写' : '可选，粘贴 JD'}}</text>
    </view>

    <van-button type="primary" block loading="{{creating}}" bind:click="startSession">生成第一题</van-button>
  </view>

  <view wx:else class="session">
    <view class="progress surface">
      <text>第 {{session.currentIndex + 1}} / {{session.totalQuestions}} 题</text>
      <text>{{session.status === 'COMPLETED' ? '训练已完成' : '训练进行中'}}</text>
    </view>
    <view wx:if="{{session.turns && session.turns.length}}" class="history surface">
      <text class="history-title">已完成题目</text>
      <view wx:for="{{session.turns}}" wx:key="id" class="history-item">
        <text>{{index + 1}}. {{item.question}}</text>
      </view>
    </view>

    <view wx:if="{{session.currentQuestion}}" class="question surface">
      <text class="question-label">当前问题</text>
      <text class="question-text">{{session.currentQuestion}}</text>
    </view>

    <view wx:if="{{session.status === 'IN_PROGRESS'}}" class="answer surface">
      <van-field
        value="{{answer}}"
        type="textarea"
        autosize
        maxlength="4000"
        placeholder="输入你的回答"
        border="{{false}}"
        bind:change="updateAnswer"
      />
      <van-button type="primary" block loading="{{submitting}}" bind:click="submitAnswer">提交回答</van-button>
    </view>

    <view wx:if="{{evaluation}}" class="feedback surface">
      <text class="feedback-title">本轮反馈</text>
      <interview-score evaluation="{{evaluation}}"></interview-score>
      <view class="feedback-section">
        <text>优点</text>
        <text wx:for="{{evaluation.strengths}}" wx:key="*this" class="feedback-item">{{item}}</text>
      </view>
      <view class="feedback-section">
        <text>待加强</text>
        <text wx:for="{{evaluation.gaps}}" wx:key="*this" class="feedback-item gap">{{item}}</text>
      </view>
    </view>

    <view class="actions">
      <van-button wx:if="{{session.status === 'IN_PROGRESS'}}" type="default" plain bind:click="finishSession">结束训练</van-button>
      <van-button wx:if="{{session.status === 'COMPLETED'}}" type="primary" bind:click="resetSession">开始新训练</van-button>
    </view>
  </view>

  <van-popup
    show="{{showJobDescription}}"
    position="bottom"
    round
    bind:close="closeJobDescription"
  >
    <view class="jd-panel">
      <text class="jd-title">岗位描述</text>
      <text class="jd-copy">粘贴目标岗位的 JD，出题会尽量贴近岗位要求。</text>
      <van-field
        value="{{jobDescription}}"
        type="textarea"
        autosize
        maxlength="2000"
        show-word-limit
        border="{{false}}"
        placeholder="粘贴岗位描述原文"
        bind:change="updateJobDescription"
      />
      <van-button type="primary" block bind:click="closeJobDescription">完成</van-button>
    </view>
  </van-popup>
</view>
