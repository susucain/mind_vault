.header {
  display: flex;
  flex-direction: column;
  padding: 28rpx 0;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.review-entry {
  padding: 8rpx 20rpx;
  border: 1rpx solid #087f78;
  border-radius: 999rpx;
  color: #087f78;
  font-size: 24rpx;
  font-weight: 700;
}

.kicker {
  color: #b85f2b;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 16rpx;
  color: #718087;
  font-size: 28rpx;
  line-height: 1.5;
}

.training {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 36rpx 28rpx;
}

.dataset-scroll {
  min-height: 64rpx;
  margin: 8rpx 0;
  white-space: nowrap;
}

.dataset-chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid #dfe7e5;
  border-radius: 999rpx;
  color: #718087;
  background: #ffffff;
  font-size: 22rpx;
}

.dataset-chip-active,
.mode-active {
  border-color: #087f78;
  color: #087f78;
  background: #e7f5f1;
}

.mode-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.mode {
  padding: 18rpx;
  border: 1rpx solid #dfe7e5;
  border-radius: 10rpx;
  color: #4f6066;
  background: #ffffff;
  font-size: 24rpx;
  text-align: center;
}

.session {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.progress {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  color: #537176;
  font-size: 24rpx;
}

.question,
.answer,
.feedback {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
}

.question-label {
  color: #b85f2b;
  font-size: 22rpx;
  font-weight: 700;
}

.question-text {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.6;
}

.feedback-title {
  font-size: 30rpx;
  font-weight: 700;
}

.feedback-section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.feedback-item {
  color: #40766d;
  line-height: 1.5;
}

.feedback-item.gap {
  color: #a75b32;
}

.actions {
  display: flex;
  justify-content: flex-end;
}

.training-title {
  font-size: 30rpx;
  font-weight: 700;
}

.training-copy {
  color: #718087;
  font-size: 26rpx;
}

.history {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 24rpx;
}

.history-title {
  font-size: 26rpx;
  font-weight: 700;
}

.history-item {
  color: #718087;
  font-size: 23rpx;
  line-height: 1.5;
}
